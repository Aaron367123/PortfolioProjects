    {
      "id": "zero",
      "type": "CONST",
      "x": 180,
      "y": 140,
      "props": {
        "value": 0
      }
    },
    {
      "id": "A0",
      "type": "INPUT",
      "x": 60,
      "y": 60,
      "label": "A0"
    },
    {
      "id": "B0",
      "type": "INPUT",
      "x": 60,
      "y": 100,
      "label": "B0"
    },
    {
      "id": "fa0",
      "type": "SUBCIRCUIT",
      "x": 260,
      "y": 40,
      "props": {
        "chip": "full-adder"
      }
    },
    {
      "id": "S0",
      "type": "OUTPUT",
      "x": 900,
      "y": 60,
      "label": "S0"
    },
    {
      "id": "A1",
      "type": "INPUT",
      "x": 60,
      "y": 180,
      "label": "A1"
    },
    {
      "id": "B1",
      "type": "INPUT",
      "x": 60,
      "y": 220,
      "label": "B1"
    },
    {
      "id": "fa1",
      "type": "SUBCIRCUIT",
      "x": 420,
      "y": 160,
      "props": {
        "chip": "full-adder"
      }
    },
    {
      "id": "S1",
      "type": "OUTPUT",
      "x": 900,
      "y": 180,
      "label": "S1"
    },
    {
      "id": "A2",
      "type": "INPUT",
      "x": 60,
      "y": 300,
      "label": "A2"
    },
    {
      "id": "B2",
      "type": "INPUT",
      "x": 60,
      "y": 340,
      "label": "B2"
    },
    {
      "id": "fa2",
      "type": "SUBCIRCUIT",
      "x": 580,
      "y": 280,
      "props": {
        "chip": "full-adder"
      }
    },
    {
      "id": "S2",
      "type": "OUTPUT",
      "x": 900,
      "y": 300,
      "label": "S2"
    },
    {
      "id": "A3",
      "type": "INPUT",
      "x": 60,
      "y": 420,
      "label": "A3"
    },
    {
      "id": "B3",
      "type": "INPUT",
      "x": 60,
      "y": 460,
      "label": "B3"
    },
    {
      "id": "fa3",
      "type": "SUBCIRCUIT",
      "x": 740,
      "y": 400,
      "props": {
        "chip": "full-adder"
      }
    },
    {
      "id": "S3",
      "type": "OUTPUT",
      "x": 900,
      "y": 420,
      "label": "S3"
    },
    {
      "id": "COUT",
      "type": "OUTPUT",
      "x": 900,
      "y": 480,
      "label": "COUT"
    }
  ],
  "wires": [
    {
      "from": "A0.out",
      "to": "fa0.A"
    },
    {
      "from": "B0.out",
      "to": "fa0.B"
    },
    {
      "from": "zero.out",
      "to": "fa0.CIN"
    },
    {
      "from": "fa0.S",
      "to": "S0.in"
    },
    {
      "from": "A1.out",
      "to": "fa1.A"
    },
    {
      "from": "B1.out",
      "to": "fa1.B"
    },
    {
      "from": "fa0.COUT",
      "to": "fa1.CIN"
    },
    {
      "from": "fa1.S",
      "to": "S1.in"
    },
    {
      "from": "A2.out",
      "to": "fa2.A"
    },
    {
      "from": "B2.out",
      "to": "fa2.B"
    },
    {
      "from": "fa1.COUT",
      "to": "fa2.CIN"
    },
    {
      "from": "fa2.S",
      "to": "S2.in"
    },
    {
      "from": "A3.out",
      "to": "fa3.A"
    },
    {
      "from": "B3.out",
      "to": "fa3.B"
    },
    {
      "from": "fa2.COUT",
      "to": "fa3.CIN"
    },
    {
      "from": "fa3.S",
