      "type": "INPUT",
      "x": 60,
      "y": 160,
      "label": "A0"
    },
    {
      "id": "EN",
      "type": "INPUT",
      "x": 60,
      "y": 480,
      "label": "EN",
      "props": {
        "value": 1
      }
    },
    {
      "id": "na1",
      "type": "NOT",
      "x": 180,
      "y": 60
    },
    {
      "id": "na0",
      "type": "NOT",
      "x": 180,
      "y": 160
    },
    {
      "id": "y0g",
      "type": "AND",
      "x": 440,
      "y": 60,
      "props": {
        "inputs": 3
      }
    },
    {
      "id": "Y0",
      "type": "OUTPUT",
      "x": 600,
      "y": 80,
      "label": "Y0"
    },
    {
      "id": "y1g",
      "type": "AND",
      "x": 440,
      "y": 180,
      "props": {
        "inputs": 3
      }
    },
    {
      "id": "Y1",
      "type": "OUTPUT",
      "x": 600,
      "y": 200,
      "label": "Y1"
    },
    {
      "id": "y2g",
      "type": "AND",
      "x": 440,
      "y": 300,
      "props": {
        "inputs": 3
      }
    },
    {
      "id": "Y2",
      "type": "OUTPUT",
      "x": 600,
      "y": 320,
      "label": "Y2"
    },
    {
      "id": "y3g",
      "type": "AND",
      "x": 440,
      "y": 420,
      "props": {
        "inputs": 3
      }
    },
    {
      "id": "Y3",
      "type": "OUTPUT",
      "x": 600,
      "y": 440,
      "label": "Y3"
    }
