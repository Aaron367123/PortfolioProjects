  "wires": [
    {
      "from": "A1.out",
      "to": "na1.in"
    },
    {
      "from": "A0.out",
      "to": "na0.in"
    },
    {
      "from": "na1.out",
      "to": "y0g.in0"
    },
    {
      "from": "na0.out",
      "to": "y0g.in1"
    },
    {
      "from": "EN.out",
      "to": "y0g.in2"
    },
    {
      "from": "y0g.out",
      "to": "Y0.in"
    },
    {
      "from": "na1.out",
      "to": "y1g.in0"
    },
    {
      "from": "A0.out",
      "to": "y1g.in1"
    },
    {
      "from": "EN.out",
      "to": "y1g.in2"
    },
    {
      "from": "y1g.out",
      "to": "Y1.in"
    },
    {
      "from": "A1.out",
      "to": "y2g.in0"
    },
    {
      "from": "na0.out",
      "to": "y2g.in1"
    },
    {
      "from": "EN.out",
      "to": "y2g.in2"
    },
    {
      "from": "y2g.out",
      "to": "Y2.in"
    },
    {
      "from": "A1.out",
      "to": "y3g.in0"
    },
    {
      "from": "A0.out",
      "to": "y3g.in1"
    },
    {
