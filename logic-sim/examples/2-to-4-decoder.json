{
  "schema": "logic-sim",
  "version": 1,
  "name": "2-to-4-decoder",
  "description": "Exactly one output goes high: the one selected by A1 A0, while EN is high.",
  "components": [
    {
      "id": "A1",
      "type": "INPUT",
      "x": 60,
      "y": 60,
      "label": "A1"
    },
    {
