# Copy to .env and adjust. Every value has a safe development default.
NODE_ENV=development
PORT=3000
# 127.0.0.1 keeps the dev server off your LAN; Docker uses 0.0.0.0.
HOST=127.0.0.1
DB_PATH=data/myousik.db

# Add demo songs/playlists on startup if the database is empty.
SEED_IF_EMPTY=false
# Password for the seeded "demo" account (dev fixture, not a secret).
DEMO_PASSWORD=myousik-demo-1

SESSION_TTL_HOURS=168
# Defaults to true when NODE_ENV=production. Requires HTTPS (localhost is exempt in modern browsers).
# COOKIE_SECURE=true
# Only enable behind a reverse proxy you control.
TRUST_PROXY=false

LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS_PER_IP=50
FEEDBACK_MAX_PER_HOUR=20
