{
  "name": "myousik-fullstack",
  "version": "2.0.0",
  "description": "Myousik 2.0 - a full-stack rebuild of a college music-streaming mockup: Express REST API, SQLite (node:sqlite), session auth and a vanilla-JS front end.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server.js",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.js",
    "seed:reset": "node --disable-warning=ExperimentalWarning scripts/seed.js --reset",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\""
  },
  "keywords": [
    "express",
    "sqlite",
    "rest-api",
    "crud",
    "music"
  ],
  "author": "Aaron Morris Jara",
  "license": "MIT",
  "dependencies": {
    "express": "^5.3.0"
  }
}
