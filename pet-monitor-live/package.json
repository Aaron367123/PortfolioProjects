{
  "name": "pet-monitor-live",
  "version": "1.0.0",
  "description": "Live IoT dashboard for the Smart Pet Monitor: REST ingest, calibration, visit detection, alerts, SQLite history and WebSocket streaming.",
  "type": "module",
  "license": "MIT",
  "author": "Aaron Morris Jara",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "simulate": "node --env-file-if-exists=.env simulator/run.js",
    "test": "node --test --test-reporter=spec \"test/*.test.js\"",
    "build:demo": "node scripts/build-demo.js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
