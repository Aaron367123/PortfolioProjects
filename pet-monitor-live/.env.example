# Copy to .env (read automatically by npm start / npm run simulate via --env-file-if-exists).

# HTTP + WebSocket port and bind address (use 0.0.0.0 so a Pi on the LAN can reach it)
PORT=5602
HOST=127.0.0.1

# SQLite file (":memory:" for a throwaway run)
DB_PATH=./data/pet-monitor.db

# Per-device API keys: deviceId:key pairs, comma separated.
# Leave empty for development mode: any deviceId may post with X-Device-Key: dev-device-key
DEVICE_KEYS=
# DEVICE_KEYS=pi-kitchen:change-me-long-random-string,sim-1:another-random-string

# Optional: protects PUT /api/config and alert acknowledgement (Authorization: Bearer <token>)
ADMIN_TOKEN=

# Raw readings older than this are pruned hourly (events and alerts are kept)
RETENTION_DAYS=30

# Simulator defaults (npm run simulate)
SERVER_URL=http://127.0.0.1:5602
DEVICE_KEY=dev-device-key
